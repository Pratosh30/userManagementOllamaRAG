# Copy to .env (git-ignored). The app loads ./.env automatically on startup.
DB_URL=jdbc:mysql://localhost:3306/user_management_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=3600000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Leave MAIL_HOST empty in development: reset links are printed to the console
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_PUBLIC_URL=http://localhost:8080
